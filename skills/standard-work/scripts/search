#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
REFERENCES_DIR="$SKILL_DIR/references"

if [[ $# -eq 0 ]]; then
  echo "usage: bash scripts/search <query> [rg args...]" >&2
  exit 2
fi

query="$1"
shift

if command -v rg >/dev/null 2>&1; then
  rg --heading --line-number --context 2 "$query" "$REFERENCES_DIR" "$@"
else
  grep -RIn -- "$query" "$REFERENCES_DIR" "$@"
fi
